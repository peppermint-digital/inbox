{
    "name": "@peppermint-digital/inbox",
    "version": "0.1.0",
    "description": "Gemeinsame Inbox fuer die Peppermint-Systeme — eine Liste, viele Arten, alle Systeme",
    "license": "UNLICENSED",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepare": "npm run build"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.2.0"
    },
    "peerDependencies": {
        "lucide-react": ">=0.400.0 <2",
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "jsdom": "^26.0.0",
        "lucide-react": "^0.468.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "vitest": "^3.0.0"
    }
}
