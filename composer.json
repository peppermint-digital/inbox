{
    "name": "peppermint/inbox",
    "description": "Gemeinsame Inbox fuer die Peppermint-Systeme — eine Liste, viele Arten, alle Systeme",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "peppermint/ai-brain-bridge": "dev-main"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Peppermint\\Inbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Peppermint\\Inbox\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Peppermint\\Inbox\\InboxServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/peppermint-digital/ai-brain-bridge.git"
        }
    ]
}
